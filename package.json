{
  "name": "reviz-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "host": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:server": "vite build --config vite.server.config.ts",
    "server": "npm run build:server && node dist-server/server.js",
    "start": "node dist-server/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "voxels": "node scripts/voxels/build-weapons.ts",
    "maps": "node scripts/maps/build-maps.ts"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "three": "^0.187.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
